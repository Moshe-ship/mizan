{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Moshe-ship/mizan/schema/receipt-v0.schema.json",
  "title": "Mizan Receipt v0",
  "description": "A signed evidence object for one agent turn. See docs/RECEIPT_SPEC.md.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "receipt_id",
    "created_at",
    "subject",
    "input",
    "output",
    "decision",
    "execution",
    "claim",
    "verification",
    "stages",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "mizan.receipt/0" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "model", "run_id", "tool"],
      "properties": {
        "agent_id": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "tool": { "type": ["string", "null"] }
      }
    },
    "input": { "$ref": "#/$defs/hashed" },
    "output": { "$ref": "#/$defs/hashed" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason"],
      "properties": {
        "action": { "enum": ["allowed", "blocked", "escalated"] },
        "reason": { "type": "string" }
      }
    },
    "execution": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "args_hash", "result_hash", "observed_status"],
          "properties": {
            "tool": { "type": ["string", "null"] },
            "args_hash": { "$ref": "#/$defs/hashOrNull" },
            "result_hash": { "$ref": "#/$defs/hashOrNull" },
            "observed_status": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "claim": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "result_hash"],
          "properties": {
            "tool": { "type": ["string", "null"] },
            "result_hash": { "$ref": "#/$defs/hashOrNull" }
          }
        }
      ]
    },
    "verification": {
      "enum": ["verified", "unverified", "tampered", "not_applicable"]
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stageRecord" }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "HMAC-SHA256" },
        "key_id": { "type": ["string", "null"] },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "hashed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "summary"],
      "properties": {
        "hash": { "$ref": "#/$defs/hash" },
        "summary": { "type": ["string", "null"] }
      }
    },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hashOrNull": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
    },
    "stageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "tool", "ok", "changes", "detail"],
      "properties": {
        "stage": {
          "enum": ["scan", "restore", "balance", "classify", "constrain", "verify"]
        },
        "tool": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "changes": { "type": "integer", "minimum": 0 },
        "detail": { "type": "object" }
      }
    }
  }
}
